# ==============================================================================
# FairStay Production Environment Variables (.env)
# ==============================================================================

# Node Environment & Server Port (Platforms like Render / Railway set PORT automatically)
NODE_ENV=production
PORT=8080
APP_BASE_URL=https://your-domain.onrender.com

# MongoDB Atlas Cloud Database URI
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/FairStay?retryWrites=true&w=majority
ATLAS_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/FairStay?retryWrites=true&w=majority

# Express Session Encryption Secret
SESSION_SECRET=fairstay_production_secret_key_change_me_to_random_string

# Cloudinary (Listing Image Uploads & Hosting)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret

# Google Gemini API Key (AI Travel Concierge & Smart Natural Language Search)
GEMINI_API_KEY=your_google_gemini_api_key

# Google Maps / Places API Key (Stay locations & photos)
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Stripe Payment Gateway (Card checkout)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Gmail SMTP (6-Digit OTP Email Verification & Booking Confirmations)
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password
