# Server & Environment Configuration
PORT=8080
NODE_ENV=development
APP_BASE_URL=http://localhost:8080
SESSION_SECRET=fairstay_production_secret_key_change_in_production

# MongoDB Database Connection
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fairstay?retryWrites=true&w=majority

# Google Gemini AI (Interactive Trip Concierge & Smart Search)
GEMINI_API_KEY=your_google_gemini_api_key

# Email Verification (Resend HTTP REST API - Recommended for Render)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=FairStay <onboarding@resend.dev>

# Nodemailer / Gmail SMTP (Optional Fallback)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_16_digit_app_password

# Stripe Payments (For Bookings Checkout)
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_PUBLISHABLE_KEY=pk_test_51...

# Cloudinary Storage (For Host Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret
