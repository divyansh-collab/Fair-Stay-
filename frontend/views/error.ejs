<% layout('/layouts/boilerplate') %>

<div class="container my-5 py-5 text-center">
  <div class="row justify-content-center">
    <div class="col-md-7">
      
      <div class="card border-0 shadow-sm rounded-4 p-5 bg-white">
        <div class="display-1 mb-3">🏡</div>
        <h2 class="fw-bold text-dark mb-2">
          <%= statusCode || 500 %> — Page Notice
        </h2>
        <p class="text-muted mb-4 lead">
          <%= message || 'The page or listing you are looking for is currently unavailable.' %>
        </p>
        
        <div class="d-flex justify-content-center gap-3">
          <a href="/listings" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm">
            <i class="bi bi-house-door me-1"></i> Return to Explore Stays
          </a>
          <button onclick="history.back()" class="btn btn-outline-secondary rounded-pill px-4 py-2">
            Go Back
          </button>
        </div>

        <% if (process.env.NODE_ENV !== 'production' && err && err.stack) { %>
          <div class="mt-4 text-start bg-light p-3 rounded-3 overflow-x-auto">
            <h6 class="fw-bold text-danger">Debug Stack Trace:</h6>
            <pre class="small text-muted mb-0"><code><%= err.stack %></code></pre>
          </div>
        <% } %>

      </div>

    </div>
  </div>
</div>
