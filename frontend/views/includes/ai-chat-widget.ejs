<!-- Floating ✨ FairStay AI Concierge Widget -->
<div class="ai-concierge-container">
  
  <!-- Floating Launcher Button (3D Living Holographic Orb) -->
  <button id="aiLauncherBtn" class="btn btn-primary rounded-pill shadow-lg d-flex align-items-center gap-2 px-3 py-2 border-0 ai-launcher-btn magnetic-btn-3d" type="button" aria-label="Open AI Concierge">
    <span class="ai-sparkle-icon fs-5">✨</span>
    <span class="fw-bold d-none d-sm-inline">FairStay AI Trip Assistant</span>
    <span class="fw-bold d-sm-none">Ask AI</span>
  </button>

  <!-- Expandable Chat Panel -->
  <div id="aiChatPanel" class="card shadow-2xl border-0 rounded-4 ai-chat-panel d-none">
    
    <!-- Chat Header -->
    <div class="card-header bg-gradient-primary text-white border-0 py-3 px-3 d-flex align-items-center justify-content-between rounded-top-4">
      <div class="d-flex align-items-center gap-2">
        <div class="rounded-circle bg-white text-primary p-1 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
          <span>🏡</span>
        </div>
        <div>
          <h6 class="mb-0 fw-bold">FairStay AI Travel Concierge</h6>
          <small class="text-white-50" style="font-size: 0.72rem;">Goa • Manali • Jaipur • Mumbai • Kerala • Himalayas</small>
        </div>
      </div>
      <div class="d-flex align-items-center gap-1">
        <button id="aiResetChatBtn" class="btn btn-sm btn-link text-white text-decoration-none p-1" title="Clear Chat">
          <i class="bi bi-arrow-counterclockwise"></i>
        </button>
        <button id="aiCloseChatBtn" class="btn btn-sm btn-link text-white text-decoration-none p-1" title="Close">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
    </div>

    <!-- Chat Messages Body -->
    <div class="card-body p-3 overflow-y-auto ai-chat-body" id="aiChatBody">
      <!-- Welcome Message -->
      <div class="chat-message bot-message mb-3">
        <div class="chat-bubble bot-bubble shadow-sm">
          👋 <strong>Hello traveler!</strong> Welcome to FairStay.
          <br /><br />
          I can help you find stunning **private pool villas in Goa**, **mountain chalets in Manali**, **royal havelis in Jaipur & Udaipur**, or **remote workation lofts with fast Wi-Fi**.
          <br /><br />
          Where are you dreaming of heading for your next getaway?
        </div>
      </div>
    </div>

    <!-- Quick Prompt Pills -->
    <div class="px-3 py-2 bg-light border-top border-bottom overflow-x-auto d-flex gap-2 ai-pills-bar text-nowrap">
      <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill ai-quick-pill" data-prompt="What are the best beachfront villas in Goa with private pool?">
        🏖️ Beach Villas in Goa
      </button>
      <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill ai-quick-pill" data-prompt="Show me wooden mountain chalets and cottages in Manali with pine views.">
        🏔️ Manali Mountain Cabins
      </button>
      <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill ai-quick-pill" data-prompt="What are the top heritage haveli stays in Jaipur and Udaipur?">
        🏰 Royal Rajasthan Havelis
      </button>
      <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill ai-quick-pill" data-prompt="Find workation stays with fast 100+ Mbps wifi and workspace.">
        💻 Fast Wi-Fi Workations
      </button>
      <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill ai-quick-pill" data-prompt="What are the evening Aarti timings at Dashashwamedh Ghat?">
        🪔 Varanasi Ghat Guide
      </button>
    </div>

    <!-- Chat Input Area -->
    <div class="card-footer bg-white border-0 p-3 rounded-bottom-4">
      <form id="aiChatForm" class="d-flex align-items-center gap-2 m-0">
        <input
          type="text"
          id="aiChatInput"
          class="form-control rounded-pill border py-2 px-3"
          placeholder="Ask for stays, getaways, dining, activities..."
          autocomplete="off"
          required
        />
        <button class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center p-2" type="submit" style="width: 40px; height: 40px;" aria-label="Send Message">
          <i class="bi bi-send-fill" style="font-size: 0.9rem;"></i>
        </button>
      </form>
    </div>

  </div>
</div>
