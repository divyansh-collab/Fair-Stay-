<!-- 1. Smart Search Modal (Top-Anchored Luxury Airbnb Search Hub) -->
<div class="modal fade" id="smartSearchModal" tabindex="-1" aria-labelledby="smartSearchModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-top modal-lg search-modal-dialog">
    <div class="modal-content border-0 search-modal-content overflow-hidden shadow-2xl">
      <div class="modal-header border-bottom px-4 py-3 search-modal-header d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
          <span class="fs-4">✨</span>
          <div>
            <h5 class="modal-title fw-bold mb-0" id="smartSearchModalLabel">FairStay Vacation Search</h5>
            <small class="text-muted">Find luxury villas, mountain cabins, and beach getaways</small>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-4">
        <!-- Natural Language AI Search Form -->
        <form action="/ai/smart-search" method="POST" id="smartSearchForm">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <label class="form-label fw-bold mb-0">
              Where would you like to go?
            </label>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 small">
              <i class="bi bi-stars me-1"></i> Gemini AI Search
            </span>
          </div>

          <div class="input-group mb-3 shadow-sm rounded-pill overflow-hidden border p-1 search-input-wrapper">
            <span class="input-group-text border-0 ps-3">
              <i class="bi bi-search text-primary fs-5"></i>
            </span>
            <input
              type="text"
              name="query"
              id="naturalSearchInput"
              class="form-control border-0 py-2 pe-3"
              placeholder="e.g., Beachfront villa in Goa with pool under ₹6000"
              autocomplete="off"
              required
            />
            <button class="btn btn-search-submit px-4 rounded-pill fw-bold" type="submit">
              Search Stays
            </button>
          </div>

          <!-- Live Instant Search Auto-Suggest Container -->
          <div id="liveSearchResults" class="mb-3 d-none rounded-4 border p-2 bg-body-tertiary shadow-sm">
            <div class="d-flex align-items-center justify-content-between px-2 py-1 border-bottom mb-2">
              <span class="small fw-bold text-muted text-uppercase" style="font-size: 0.75rem;">Instant Stays (<span id="liveResultsCount">0</span> found)</span>
              <span class="small text-primary fw-semibold" style="font-size: 0.75rem;">Click stay or press Enter for AI Search</span>
            </div>
            <div id="liveResultsList" class="d-flex flex-column gap-2" style="max-height: 260px; overflow-y: auto;">
              <!-- Rendered dynamically via /api/search -->
            </div>
          </div>

          <!-- Quick Suggestion Pills -->
          <div class="mb-4">
            <span class="small text-muted fw-semibold me-2">Popular searches:</span>
            <div class="d-flex flex-wrap gap-2 mt-2">
              <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill search-suggestion-pill" data-query="Beachfront villa in Goa with private pool">
                🏖️ Goa Beachfront Villa
              </button>
              <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill search-suggestion-pill" data-query="Mountain cabin in Manali with pine forest views">
                🏔️ Manali Mountain Cabin
              </button>
              <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill search-suggestion-pill" data-query="Heritage haveli in Jaipur with rooftop dining">
                🏰 Jaipur Heritage Haveli
              </button>
              <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill search-suggestion-pill" data-query="Luxury villa with pool in Udaipur">
                🏊 Udaipur Pool Villa
              </button>
              <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill search-suggestion-pill" data-query="Workation apartment in Bengaluru with fast wifi">
                💻 Bengaluru Workation
              </button>
              <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill search-suggestion-pill" data-query="Backwater cottage in Kerala Alleppey">
                🌿 Kerala Backwaters
              </button>
            </div>
          </div>
        </form>

        <hr class="my-4" />

        <!-- Direct Destination Filters -->
        <h6 class="fw-bold mb-3 text-secondary text-uppercase small">Direct Destination Filters</h6>
        <form action="/listings" method="GET" class="row g-3">
          <div class="col-md-4">
            <label class="form-label small text-muted">Destination</label>
            <select name="location" class="form-select rounded-3">
              <option value="">All Destinations</option>
              <option value="Goa">Goa (Beach & Nightlife)</option>
              <option value="Manali">Manali (Himalayas)</option>
              <option value="Jaipur">Jaipur (Pink City)</option>
              <option value="Udaipur">Udaipur (Lakes & Palaces)</option>
              <option value="Mumbai">Mumbai (Urban Stays)</option>
              <option value="Bengaluru">Bengaluru (Workation)</option>
              <option value="Munnar">Munnar (Tea Estates)</option>
              <option value="Alleppey">Alleppey (Backwaters)</option>
              <option value="Rishikesh">Rishikesh (River & Yoga)</option>
              <option value="Varanasi">Varanasi (Heritage Ghats)</option>
              <option value="Prayagraj">Prayagraj (Confluence)</option>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label small text-muted">Category</label>
            <select name="category" class="form-select rounded-3">
              <option value="">All Categories</option>
              <option value="Beachfront">🏖️ Beachfront</option>
              <option value="Mountains">🏔️ Mountain Cabins</option>
              <option value="Heritage">🏰 Heritage & Mansions</option>
              <option value="Pools">🏊 Amazing Pools</option>
              <option value="City">🏙️ City Apartments</option>
              <option value="Countryside">🌿 Countryside</option>
              <option value="Workation">💻 Workation & Wi-Fi</option>
              <option value="Luxe">💎 Luxe Villas</option>
              <option value="Budget">🏷️ Budget Stays</option>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label small text-muted">Max Budget (₹)</label>
            <input type="number" name="maxPrice" class="form-control rounded-3" placeholder="e.g. 6000" min="500" step="500" />
          </div>
          <div class="col-12 text-end mt-3">
            <button type="submit" class="btn btn-dark btn-apply-filters rounded-pill px-4">
              Apply Filters
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- 2. Notifications Center Modal -->
