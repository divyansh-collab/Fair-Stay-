<% const activeUser = (typeof currUser !== 'undefined' && currUser) ? currUser : (typeof locals !== 'undefined' && locals.currUser ? locals.currUser : null); %>
<header class="sticky-top navbar-wrapper">
  <nav class="navbar border-bottom py-2">
    <div class="container d-flex align-items-center justify-content-between flex-nowrap">
      
      <!-- Brand Logo -->
      <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none py-0 flex-shrink-0 brand-hover-effect" href="/listings">
        <div class="brand-icon-wrapper shadow-sm">
          <span class="fs-4">🏡</span>
        </div>
        <div class="d-flex flex-column">
          <span class="fw-bold brand-title">FairStay<span class="brand-dot">.</span></span>
          <span class="brand-subtitle">Vacation Rentals & Homes</span>
        </div>
      </a>

      <!-- Center Search Capsule (Luxury Night Mode - Always Centered & Interactive) -->
      <div class="d-none d-md-flex align-items-center mx-3 flex-grow-0">
        <div class="search-capsule d-flex align-items-center shadow-lg" data-bs-toggle="modal" data-bs-target="#smartSearchModal" role="button" tabindex="0" title="Click to search any vacation stay, city or amenity">
          <div class="search-capsule-item fw-bold ps-3 pe-2">
            <span class="capsule-primary-text">Anywhere</span>
          </div>
          <div class="search-capsule-divider"></div>
          <div class="search-capsule-item px-2">
            <span class="capsule-sub-text">Any week</span>
          </div>
          <div class="search-capsule-divider"></div>
          <div class="search-capsule-item ps-2 pe-1">
            <span class="capsule-sub-text">Add guests</span>
          </div>
          <div class="search-btn-circle d-flex align-items-center justify-content-center me-1">
            <i class="bi bi-search text-white" style="font-size: 0.8rem;"></i>
          </div>
        </div>
      </div>

      <!-- Right Action Cluster (Single line, flex-nowrap) -->
      <div class="d-flex align-items-center gap-2 flex-nowrap flex-shrink-0">
        
        <!-- Host Link -->
        <a class="btn btn-nav-action d-none d-lg-inline-flex align-items-center gap-2 text-nowrap rounded-pill px-3 py-1" href="/listings/new">
          <i class="bi bi-house-door text-danger"></i>
          <span>List Your Property</span>
        </a>

        <!-- Theme Toggle Button (Radiant Dawn ☀️ / Velvet Nocturne 🌙) -->
        <button class="btn btn-nav-icon rounded-circle position-relative p-2" type="button" id="themeToggleBtn" title="Toggle Light / Dark theme" aria-label="Toggle Theme">
          <i class="bi bi-sun-fill fs-5 theme-icon-sun text-warning d-none"></i>
          <i class="bi bi-moon-stars-fill fs-5 theme-icon-moon text-info"></i>
        </button>

        <!-- Wishlist Saved Drawer Button -->
        <button class="btn btn-nav-icon position-relative btn-wishlist-nav" type="button" data-bs-toggle="offcanvas" data-bs-target="#wishlistDrawer" aria-controls="wishlistDrawer" title="Saved Stays & Wishlist">
          <i class="bi bi-suit-heart-fill fs-5 text-danger"></i>
          <span id="wishlistCountBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-dark" style="display: none; font-size: 0.65rem;">
            0
          </span>
        </button>

        <!-- User Menu Dropdown (Active User Mode Enhanced) -->
        <div class="dropdown">
          <button class="btn rounded-pill d-flex align-items-center gap-2 px-3 py-1 user-menu-btn shadow-sm <%= activeUser ? 'user-active-mode' : '' %>" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-list fs-5 user-menu-icon"></i>
            <% if (activeUser) { %>
              <div class="position-relative d-inline-flex align-items-center">
                <% if (activeUser.profilePhoto && activeUser.profilePhoto.url) { %>
                  <img src="<%= activeUser.profilePhoto.url %>" alt="<%= activeUser.username %>" class="rounded-circle user-avatar-thumb" />
                <% } else { %>
                  <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center user-avatar-thumb fw-bold" style="font-size: 0.85rem;">
                    <%= activeUser.username.charAt(0).toUpperCase() %>
                  </div>
                <% } %>
                <!-- Live Glowing Emerald Active Dot -->
                <span class="position-absolute bottom-0 end-0 p-1 bg-success border border-dark rounded-circle online-status-dot" title="Active"></span>
              </div>
              <span class="fw-bold small d-none d-lg-inline user-name-label">
                <%= activeUser.username %>
              </span>
            <% } else { %>
              <div class="rounded-circle bg-secondary-subtle d-flex align-items-center justify-content-center user-avatar-thumb">
                <i class="bi bi-person-fill text-muted"></i>
              </div>
            <% } %>
          </button>
          
          <ul class="dropdown-menu dropdown-menu-end shadow-2xl border border-secondary border-opacity-25 mt-2 rounded-4 py-2 navbar-glass-dropdown" aria-labelledby="userMenuDropdown" style="min-width: 260px;">
            <% if (!activeUser) { %>
              <li><a class="dropdown-item py-2 fw-bold d-flex align-items-center" href="/login"><i class="bi bi-box-arrow-in-right me-2 text-primary fs-6"></i> Log in</a></li>
              <li><a class="dropdown-item py-2 d-flex align-items-center" href="/signup"><i class="bi bi-person-plus me-2 text-success fs-6"></i> Sign up with Gmail</a></li>
              <li><hr class="dropdown-divider border-secondary border-opacity-25"></li>
              <li><a class="dropdown-item py-2 d-flex align-items-center" href="#" data-bs-toggle="modal" data-bs-target="#smartSearchModal"><i class="bi bi-stars me-2 text-warning fs-6"></i> AI Smart Search</a></li>
              <li><a class="dropdown-item py-2 d-flex align-items-center" href="#" data-bs-toggle="modal" data-bs-target="#experiencesModal"><i class="bi bi-compass me-2 text-info fs-6"></i> Curated Experiences</a></li>
              <li><a class="dropdown-item py-2 d-flex align-items-center" href="#" data-bs-toggle="modal" data-bs-target="#helpCenterModal"><i class="bi bi-shield-check me-2 text-success fs-6"></i> FairSafe™ Zero-Surge Guarantee</a></li>
              <li><a class="dropdown-item py-2 d-flex align-items-center dropdown-theme-toggle" href="#" id="dropdownThemeToggle"><i class="bi bi-circle-half me-2 text-warning fs-6"></i> Toggle Theme (Light / Dark)</a></li>
            <% } else { %>
              <!-- Active User Profile Card -->
              <li class="px-3 py-2 border-bottom mb-1 user-dropdown-header rounded-top-3">
                <div class="d-flex align-items-center gap-2 mb-1">
                  <div class="position-relative">
                    <% if (activeUser.profilePhoto && activeUser.profilePhoto.url) { %>
                      <img src="<%= activeUser.profilePhoto.url %>" alt="<%= activeUser.username %>" class="rounded-circle user-avatar-thumb" />
                    <% } else { %>
                      <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center user-avatar-thumb fw-bold" style="font-size: 0.85rem;">
                        <%= activeUser.username.charAt(0).toUpperCase() %>
                      </div>
                    <% } %>
                    <span class="position-absolute bottom-0 end-0 p-1 bg-success border border-dark rounded-circle online-status-dot"></span>
                  </div>
                  <div class="flex-grow-1 overflow-hidden">
                    <div class="fw-bold user-profile-name text-truncate"><%= activeUser.username %></div>
                    <div class="small user-profile-email text-truncate" style="font-size: 0.75rem;"><%= activeUser.email %></div>
                  </div>
                </div>
                <div class="d-flex align-items-center gap-1 mt-1">
                  <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill" style="font-size: 0.68rem;">
                    <span class="online-pulse-dot me-1"></span> Active Verified
                  </span>
                  <% if (activeUser.isAdmin) { %>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill" style="font-size: 0.68rem;">
                      👑 Admin
                    </span>
                  <% } %>
                </div>
              </li>
              <li><a class="dropdown-item py-2 d-flex align-items-center" href="/bookings"><i class="bi bi-suitcase-lg me-2 text-primary fs-6"></i> My Trips</a></li>
              <li><a class="dropdown-item py-2 d-flex align-items-center" href="/profile"><i class="bi bi-person-circle me-2 text-secondary fs-6"></i> Account Profile</a></li>
              <li><a class="dropdown-item py-2 d-flex align-items-center" href="/bookings/host/panel"><i class="bi bi-graph-up-arrow me-2 text-info fs-6"></i> Superhost Dashboard</a></li>
              <li><a class="dropdown-item py-2 d-flex align-items-center" href="/listings/new"><i class="bi bi-house-add me-2 text-success fs-6"></i> Host a New Stay</a></li>
              <li><hr class="dropdown-divider border-secondary border-opacity-25"></li>
              <li><a class="dropdown-item py-2 d-flex align-items-center" href="#" data-bs-toggle="modal" data-bs-target="#smartSearchModal"><i class="bi bi-stars me-2 text-warning fs-6"></i> AI Smart Search</a></li>
              <li><a class="dropdown-item py-2 d-flex align-items-center" href="#" data-bs-toggle="modal" data-bs-target="#helpCenterModal"><i class="bi bi-shield-check me-2 text-success fs-6"></i> FairSafe™ Zero-Surge Guarantee</a></li>
              <li><a class="dropdown-item py-2 d-flex align-items-center dropdown-theme-toggle" href="#" id="dropdownThemeToggleLoggedIn"><i class="bi bi-circle-half me-2 text-warning fs-6"></i> Toggle Theme (Light / Dark)</a></li>
              <li><hr class="dropdown-divider border-secondary border-opacity-25"></li>
              <!-- Prominent Log Out Button -->
              <li>
                <a class="dropdown-item py-2 text-danger fw-bold rounded-3 d-flex align-items-center justify-content-between logout-item" href="/logout">
                  <span class="d-flex align-items-center">
                    <i class="bi bi-box-arrow-right me-2 fs-5"></i> Log out
                  </span>
                  <span class="badge bg-danger-subtle text-danger rounded-pill small">Active</span>
                </a>
              </li>
            <% } %>
          </ul>
        </div>
      </div>
    </div>
  </nav>

  <!-- Mobile Search Bar (< md screens) -->
  <div class="d-md-none p-2 border-bottom mobile-search-bar-strip">
    <div class="search-capsule d-flex align-items-center shadow-sm w-100 justify-content-between px-3" data-bs-toggle="modal" data-bs-target="#smartSearchModal" role="button">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-search text-danger"></i>
        <span class="small fw-semibold mobile-search-prompt">Where to next?</span>
      </div>
      <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">AI Search</span>
    </div>
  </div>
</header>
