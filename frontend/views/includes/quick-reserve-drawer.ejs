<!-- Offcanvas Quick Reserve Drawer -->
<div class="offcanvas offcanvas-end border-0 shadow-2xl rounded-start-4" tabindex="-1" id="quickReserveDrawer" aria-labelledby="quickReserveDrawerLabel" style="width: 440px; max-width: 95vw;">
  <div class="offcanvas-header border-bottom p-3 px-4 d-flex justify-content-between align-items-center">
    <div>
      <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1 small fw-bold mb-1">
        <i class="bi bi-lightning-charge-fill me-1"></i> Quick Reserve
      </span>
      <h5 class="offcanvas-title fw-bold text-dark mb-0" id="quickReserveDrawerLabel">Instant Reservation</h5>
    </div>
    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  
  <div class="offcanvas-body p-4">
    <!-- Mini Stay Card Preview -->
    <div class="d-flex align-items-center gap-3 p-2 bg-body-tertiary rounded-3 border mb-3">
      <img id="qrListingImg" src="" alt="" class="rounded-3" style="width: 72px; height: 72px; object-fit: cover;" />
      <div class="overflow-hidden">
        <h6 class="fw-bold mb-0 text-truncate text-dark" id="qrListingTitle">Stay Title</h6>
        <div class="small text-muted text-truncate" id="qrListingLocation">Location</div>
        <div class="fw-bold text-danger small mt-1" id="qrListingPrice">₹0 / night</div>
      </div>
    </div>

    <!-- Booking Form -->
    <form id="qrBookingForm" method="POST" action="">
      <!-- Dates selection -->
      <div class="reservation-date-box p-2 mb-3 border rounded-3 bg-body">
        <div class="row g-2">
          <div class="col-6 border-end">
            <label class="form-label text-uppercase fw-bold text-muted mb-0" style="font-size: 0.65rem;">Check-in</label>
            <input type="text" id="qrCheckInDate" name="booking[checkIn]" class="form-control form-control-sm border-0 bg-transparent fw-semibold p-0 cursor-pointer" placeholder="Select date" required />
          </div>
          <div class="col-6">
            <label class="form-label text-uppercase fw-bold text-muted mb-0" style="font-size: 0.65rem;">Checkout</label>
            <input type="text" id="qrCheckOutDate" name="booking[checkOut]" class="form-control form-control-sm border-0 bg-transparent fw-semibold p-0 cursor-pointer" placeholder="Select date" required />
          </div>
        </div>
      </div>

      <!-- Guests selector -->
      <div class="mb-3">
        <label class="form-label small fw-bold text-dark mb-1">Number of Guests</label>
        <div class="input-group">
          <button class="btn btn-outline-secondary" type="button" id="qrGuestsMinus">-</button>
          <input type="number" class="form-control text-center fw-bold bg-body" id="qrGuestsInput" name="booking[guests]" value="2" min="1" max="10" readonly />
          <button class="btn btn-outline-secondary" type="button" id="qrGuestsPlus">+</button>
        </div>
      </div>

      <!-- Price Breakdown with Statutory Indian GST -->
      <div class="p-3 bg-body-tertiary rounded-3 border mb-3 small">
        <div class="d-flex justify-content-between mb-2 text-muted">
          <span>₹<span id="qrNightlyPrice">0</span> × <span id="qrNightsCount">2 nights</span></span>
          <span class="text-dark fw-bold" id="qrBasePrice">₹0</span>
        </div>
        <div class="d-flex justify-content-between mb-2 text-muted">
          <span id="qrGstLabel">Taxes & GST</span>
          <span class="text-dark fw-bold" id="qrGstAmount">₹0</span>
        </div>
        <hr class="my-2" />
        <div class="d-flex justify-content-between fw-bold text-dark fs-6">
          <span>Total Payable</span>
          <span class="text-danger fs-5" id="qrTotalAmount">₹0</span>
        </div>
        <div class="small text-success mt-2">
          <i class="bi bi-shield-check me-1"></i> FairSafe™ Zero-Surge Guarantee Included
        </div>
      </div>

      <!-- Submit CTA -->
      <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm mb-2" id="qrSubmitBtn">
        <i class="bi bi-shield-lock-fill me-2"></i> Reserve Stay Instantly
      </button>

      <div class="text-center">
        <a id="qrFullDetailsLink" href="#" class="text-muted small text-decoration-none">
          <i class="bi bi-box-arrow-up-right me-1"></i> View Full Details & Reviews
        </a>
      </div>
    </form>
  </div>
</div>
