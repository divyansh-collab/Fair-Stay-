<% layout('/layouts/boilerplate') %>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      
      <div class="card border-0 shadow-2xl rounded-4 p-4 p-md-5 spatial-glass-card">
        
        <div class="mb-4 text-center">
          <span class="fs-1">✏️</span>
          <h3 class="fw-bold text-dark mt-2">Edit Vacation Stay Details</h3>
          <p class="text-muted small">Update your property photos, nightly rates, location, and guest amenities.</p>
        </div>

        <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate id="editStayForm">
          
          <!-- Title -->
          <div class="mb-3">
            <label for="title" class="form-label fw-semibold text-dark">Property Title</label>
            <input type="text" class="form-control rounded-3 py-2" id="title" name="listing[title]" value="<%= listing.title %>" required />
            <div class="invalid-feedback">Please enter a property title.</div>
          </div>

          <!-- Description -->
          <div class="mb-3">
            <label for="description" class="form-label fw-semibold text-dark">Description</label>
            <textarea class="form-control rounded-3" id="description" name="listing[description]" rows="4" required><%= listing.description %></textarea>
            <div class="invalid-feedback">Please provide a description.</div>
          </div>

          <!-- Current Image Preview & Upload New -->
          <div class="mb-4 p-3 bg-light rounded-3 border">
            <label class="form-label fw-semibold text-dark mb-2">Property Photo</label>
            <div class="mb-2 text-center">
              <img id="editImagePreview" src="<%= listing.image && listing.image.url ? listing.image.url : '' %>" alt="<%= listing.title %>" class="rounded-3 shadow-xs" style="max-height: 200px; width: auto; max-width: 100%; object-fit: cover;" />
            </div>
            <div class="row g-2">
              <div class="col-md-6">
                <input type="file" class="form-control rounded-3 py-2" id="editImageFile" name="listing[image]" accept="image/*" />
                <div class="form-text small text-muted">Upload new photo from computer.</div>
              </div>
              <div class="col-md-6">
                <input type="url" class="form-control rounded-3 py-2" id="editImageUrl" name="listing[imageUrl]" placeholder="Or enter new image URL" />
                <div class="form-text small text-muted">Direct image URL (CDN link).</div>
              </div>
            </div>
          </div>

          <!-- Price & Location -->
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label for="price" class="form-label fw-semibold text-dark">Nightly Rate (₹ INR)</label>
              <div class="input-group">
                <span class="input-group-text bg-light fw-bold">₹</span>
                <input type="number" class="form-control rounded-end-3 py-2" id="price" name="listing[price]" value="<%= listing.price %>" required />
              </div>
            </div>

            <div class="col-md-6">
              <label for="location" class="form-label fw-semibold text-dark">Destination / Address</label>
              <input type="text" class="form-control rounded-3 py-2" id="location" name="listing[location]" value="<%= listing.location %>" required />
            </div>
          </div>

          <!-- Category -->
          <div class="mb-3">
            <label for="category" class="form-label fw-semibold text-dark">Category</label>
            <select class="form-select rounded-3 py-2" id="category" name="listing[category]">
              <% const categories = ['Trending', 'Beachfront', 'Mountains', 'Heritage', 'Pools', 'City', 'Countryside', 'Workation', 'Luxe', 'Budget', 'Rooms']; %>
              <% for (let cat of categories) { %>
                <option value="<%= cat %>" <%= listing.category === cat ? 'selected' : '' %>><%= cat %></option>
              <% } %>
            </select>
          </div>

          <!-- Host Festive Pricing Policy -->
          <div class="mb-4 p-3 bg-light rounded-3 border">
            <label class="form-label fw-semibold text-dark small mb-1">
              ⚡ Host Festive Pricing Policy (Diwali, Christmas, Holi, Raksha Bandhan)
            </label>
            <select class="form-select rounded-3 py-2" name="listing[hostSurgePercentage]" id="editHostSurge">
              <option value="" <%= listing.hostSurgePercentage === null || listing.hostSurgePercentage === undefined ? 'selected' : '' %>>🤖 AI Dynamic Recommendation (Optimized per destination)</option>
              <option value="0" <%= listing.hostSurgePercentage === 0 ? 'selected' : '' %>>⚖️ 0% Flat Rate (No surge - Host guarantees flat price)</option>
              <option value="10" <%= listing.hostSurgePercentage === 10 ? 'selected' : '' %>>📈 +10% Mild Festive Adjustment</option>
              <option value="15" <%= listing.hostSurgePercentage === 15 ? 'selected' : '' %>>📈 +15% Standard Festive Adjustment</option>
              <option value="20" <%= listing.hostSurgePercentage === 20 ? 'selected' : '' %>>🔥 +20% High Demand Surge (Holi / Raksha Bandhan)</option>
              <option value="25" <%= listing.hostSurgePercentage === 25 ? 'selected' : '' %>>🎄 +25% Peak Surcharge (Christmas / Diwali)</option>
              <option value="-10" <%= listing.hostSurgePercentage === -10 ? 'selected' : '' %>>🎁 -10% Festive Promotional Discount</option>
            </select>
            <div class="form-text small text-muted">
              You decide whether your listing price increases, decreases, or stays flat during festivals. Our AI communicates your exact choice to customers.
            </div>
          </div>

          <!-- Amenities (Comma Separated) -->
          <div class="mb-4">
            <label for="amenities" class="form-label fw-semibold text-dark">Guest Amenities (Comma Separated)</label>
            <input type="text" class="form-control rounded-3 py-2" id="amenities" name="listing[amenities]" value="<%= listing.amenities ? listing.amenities.join(', ') : 'High-Speed Wi-Fi, Swimming Pool, Air Conditioning, Kitchen' %>" />
          </div>

          <!-- Submit Buttons -->
          <div class="d-flex gap-3">
            <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary rounded-pill px-4 py-2 flex-grow-1">
              Cancel
            </a>
            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 flex-grow-1 fw-bold shadow-sm magnetic-btn-3d">
              Save Changes
            </button>
          </div>

        </form>

      </div>

    </div>
  </div>
</div>

<script>
  (function () {
    const fileInput = document.getElementById('editImageFile');
    const urlInput = document.getElementById('editImageUrl');
    const previewImg = document.getElementById('editImagePreview');

    if (fileInput && previewImg) {
      fileInput.addEventListener('change', function () {
        if (this.files && this.files[0]) {
          const reader = new FileReader();
          reader.onload = function (e) {
            previewImg.src = e.target.result;
          };
          reader.readAsDataURL(this.files[0]);
        }
      });
    }

    if (urlInput && previewImg) {
      urlInput.addEventListener('input', function () {
        if (this.value && this.value.startsWith('http')) {
          previewImg.src = this.value;
        }
      });
    }
  })();
</script>
