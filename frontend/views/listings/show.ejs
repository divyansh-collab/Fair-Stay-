<% layout('/layouts/boilerplate') %>

<!-- Main Container -->
<div class="container my-4">
  
  <!-- Title, Location & Quick Actions Bar (Airbnb Standard) -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
    <div>
      <h2 class="fw-bold text-dark mb-1"><%= listing.title %></h2>
      <div class="d-flex flex-wrap align-items-center gap-2 text-muted small">
        <span class="d-flex align-items-center gap-1 text-dark fw-bold">
          <i class="bi bi-star-fill text-warning"></i>
          <%= avgRating > 0 ? avgRating : '5.0' %> (<%= listing.reviews.length %> <%= listing.reviews.length === 1 ? 'review' : 'reviews' %>)
        </span>
        <span>•</span>
        <span class="d-flex align-items-center gap-1">
          <i class="bi bi-geo-alt-fill text-danger"></i>
          <%= listing.location %>, <%= listing.country %>
        </span>
        <span>•</span>
        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">
          <i class="bi bi-shield-check me-1"></i> FairSafe™ Score: <%= listing.fairsafeScore || 95 %>/100
        </span>
        <span>•</span>
        <span class="badge bg-secondary-subtle text-secondary rounded-pill">
          <%= listing.category || 'Vacation Villa' %>
        </span>
      </div>
    </div>

    <!-- Share & Save Buttons -->
    <div class="d-flex align-items-center gap-2">
      <button class="btn btn-outline-secondary rounded-pill btn-sm px-3 d-flex align-items-center gap-2" id="shareBtn">
        <i class="bi bi-share"></i>
        <span>Share</span>
      </button>
      <button
        class="btn btn-outline-secondary rounded-pill btn-sm px-3 d-flex align-items-center gap-2 btn-wishlist-heart"
        data-id="<%= listing._id %>"
        data-title="<%= listing.title %>"
        data-price="<%= listing.price %>"
        data-location="<%= listing.location %>"
        data-image="<%= listing.image && listing.image.url ? listing.image.url : '' %>"
        id="saveStayBtn"
      >
        <i class="bi bi-suit-heart heart-icon text-danger"></i>
        <span id="saveBtnText">Save</span>
      </button>
    </div>
  </div>

  <!-- Interactive 5-Photo Bento Showcase (Airbnb Signature Luxury Layout) -->
  <% 
    const organicPhoto = listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1580587771525-78b9dba3b914?auto=format&fit=crop&w=1200&q=80';
    const photo2 = 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=1200&q=80';
    const photo3 = 'https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=1200&q=80';
    const photo4 = 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80';
    const photo5 = 'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=1200&q=80';
  %>
  <div class="photo-bento-grid mb-5 shadow-sm">
    <!-- Main Big Photo (Left) -->
    <div class="photo-bento-item main-hero cursor-pointer" data-bs-toggle="modal" data-bs-target="#galleryModal" data-gallery-index="0" onclick="openGalleryModal(0)" title="Click to view photo gallery">
      <img src="<%= organicPhoto %>" alt="<%= listing.title %>" id="mainHeroImg" />
      <span class="badge bg-dark bg-opacity-75 text-white position-absolute top-0 start-0 m-3 rounded-pill px-3 py-1 small backdrop-blur">
        <i class="bi bi-patch-check-fill text-success me-1"></i> Verified Stay
      </span>
    </div>
    <!-- Photo 2 (Top Right 1) -->
    <div class="photo-bento-item cursor-pointer" data-bs-toggle="modal" data-bs-target="#galleryModal" data-gallery-index="1" onclick="openGalleryModal(1)" title="Click to view Architecture & Grounds">
      <img src="<%= photo2 %>" alt="Architecture & Grounds" loading="lazy" />
    </div>
    <!-- Photo 3 (Top Right 2) -->
    <div class="photo-bento-item cursor-pointer" data-bs-toggle="modal" data-bs-target="#galleryModal" data-gallery-index="2" onclick="openGalleryModal(2)" title="Click to view Master Suite & Bedroom">
      <img src="<%= photo3 %>" alt="Master Suite & Bedroom" loading="lazy" />
    </div>
    <!-- Photo 4 (Bottom Right 1) -->
    <div class="photo-bento-item cursor-pointer" data-bs-toggle="modal" data-bs-target="#galleryModal" data-gallery-index="3" onclick="openGalleryModal(3)" title="Click to view Living Lounge & Interiors">
      <img src="<%= photo4 %>" alt="Living Lounge & Interiors" loading="lazy" />
    </div>
    <!-- Photo 5 (Bottom Right 2) -->
    <div class="photo-bento-item cursor-pointer" data-bs-toggle="modal" data-bs-target="#galleryModal" data-gallery-index="4" onclick="openGalleryModal(4)" title="Click to view Scenic Patio & Views">
      <img src="<%= photo5 %>" alt="Scenic Patio & Views" loading="lazy" />
    </div>

    <!-- Show All Photos Button -->
    <button class="btn btn-sm btn-show-all-photos rounded-pill px-3 py-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#galleryModal" data-gallery-index="0" onclick="openGalleryModal(0)">
      <i class="bi bi-grid-3x3-gap-fill me-1"></i> Show all 5 photos
    </button>
  </div>

  <!-- Main Content Layout (2 Columns) -->
  <div class="row g-5">
    
    <!-- Left Column: Story, Highlights, Sleeping, Amenities, Map, Reviews -->
    <div class="col-lg-7">
      
      <!-- Host & Capacity Header -->
      <div class="d-flex align-items-center justify-content-between border-bottom pb-4 mb-4">
        <div>
          <h4 class="fw-bold text-dark mb-1">
            Entire <%= listing.category || 'home' %> hosted by <%= listing.owner ? listing.owner.username : 'Superhost' %>
          </h4>
          <p class="text-muted small mb-0">
            4 guests • 2 bedrooms • 2 beds • 2 private baths
          </p>
        </div>
        <div class="position-relative">
          <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold fs-4 shadow-sm" style="width: 54px; height: 54px;">
            <%= listing.owner && listing.owner.username ? listing.owner.username.charAt(0).toUpperCase() : 'H' %>
          </div>
          <span class="position-absolute bottom-0 end-0 bg-warning text-dark rounded-circle p-1 d-flex align-items-center justify-content-center shadow-xs" title="Superhost" style="width: 20px; height: 20px;">
            <i class="bi bi-award-fill" style="font-size: 0.65rem;"></i>
          </span>
        </div>
      </div>

      <!-- 3 Key Stay Highlights (Simple & Clear) -->
      <div class="border-bottom pb-4 mb-4">
        <div class="d-flex align-items-start gap-3 mb-3">
          <div class="p-2 rounded-3 bg-light text-dark">
            <i class="bi bi-key-fill fs-5 text-primary"></i>
          </div>
          <div>
            <h6 class="fw-bold text-dark mb-0">Self check-in experience</h6>
            <small class="text-muted">Check yourself in effortlessly with the smart digital keypad.</small>
          </div>
        </div>

        <div class="d-flex align-items-start gap-3 mb-3">
          <div class="p-2 rounded-3 bg-light text-dark">
            <i class="bi bi-wifi fs-5 text-success"></i>
          </div>
          <div>
            <h6 class="fw-bold text-dark mb-0">Superfast Wi-Fi (100+ Mbps)</h6>
            <small class="text-muted">Verified fiber connection for streaming and remote working.</small>
          </div>
        </div>

        <div class="d-flex align-items-start gap-3">
          <div class="p-2 rounded-3 bg-light text-dark">
            <i class="bi bi-shield-check fs-5 text-danger"></i>
          </div>
          <div>
            <h6 class="fw-bold text-dark mb-0">FairSafe™ Zero-Surge Guarantee</h6>
            <small class="text-muted">Transparent pricing protection and 100% full refund up to 48 hours before check-in.</small>
          </div>
        </div>
      </div>

      <!-- About this Space -->
      <div class="border-bottom pb-4 mb-4">
        <h5 class="fw-bold text-dark mb-3">About this space</h5>
        <p class="text-secondary lh-lg mb-0" style="white-space: pre-line;"><%= listing.description %></p>
      </div>

      <!-- Where you'll sleep -->
      <div class="border-bottom pb-4 mb-4">
        <h5 class="fw-bold text-dark mb-3">Where you'll sleep</h5>
        <div class="row g-3">
          <div class="col-6 col-sm-4">
            <div class="card border rounded-4 p-3 h-100 bg-body shadow-xs">
              <span class="fs-4 mb-2">🛏️</span>
              <h6 class="fw-bold mb-1 small text-dark">Bedroom 1</h6>
              <span class="text-muted" style="font-size: 0.8rem;">1 Queen Bed</span>
            </div>
          </div>
          <div class="col-6 col-sm-4">
            <div class="card border rounded-4 p-3 h-100 bg-body shadow-xs">
              <span class="fs-4 mb-2">🛏️</span>
              <h6 class="fw-bold mb-1 small text-dark">Bedroom 2</h6>
              <span class="text-muted" style="font-size: 0.8rem;">2 Single Beds</span>
            </div>
          </div>
          <div class="col-6 col-sm-4 d-none d-sm-block">
            <div class="card border rounded-4 p-3 h-100 bg-body shadow-xs">
              <span class="fs-4 mb-2">🛋️</span>
              <h6 class="fw-bold mb-1 small text-dark">Living Area</h6>
              <span class="text-muted" style="font-size: 0.8rem;">1 Sofa Sleeper</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Interactive Amenities Section -->
      <div class="border-bottom pb-4 mb-4">
        <h5 class="fw-bold text-dark mb-3">What this place offers</h5>
        <div class="row g-3 mb-3">
          <% 
            const displayAmenities = [
              { icon: 'bi-water', text: 'Private Swimming Pool' },
              { icon: 'bi-wifi', text: 'Fast Wi-Fi (100+ Mbps)' },
              { icon: 'bi-snow', text: 'Air Conditioning' },
              { icon: 'bi-laptop', text: 'Dedicated Workspace' },
              { icon: 'bi-p-circle', text: 'Free Private Parking' },
              { icon: 'bi-cup-hot', text: 'Espresso Coffee Machine' }
            ];
          %>
          <% for (let a of displayAmenities) { %>
            <div class="col-sm-6 d-flex align-items-center gap-3 text-dark">
              <i class="bi <%= a.icon %> text-primary fs-5"></i>
              <span class="fw-medium small"><%= a.text %></span>
            </div>
          <% } %>
        </div>

        <!-- Button to open Full Amenities Modal -->
        <button class="btn btn-outline-dark rounded-pill px-4 py-2 mt-2 fw-semibold btn-sm" data-bs-toggle="modal" data-bs-target="#allAmenitiesModal">
          Show all 12 amenities
        </button>
      </div>

      <!-- Interactive Location & Map Section -->
      <div class="border-bottom pb-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h5 class="fw-bold text-dark mb-0">Where you'll be</h5>
          <a
            href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(listing.title + ' ' + listing.location) %>"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-sm btn-outline-primary rounded-pill px-3"
          >
            <i class="bi bi-box-arrow-up-right me-1"></i> Google Maps
          </a>
        </div>
        <p class="text-muted small mb-3">
          <i class="bi bi-geo-alt-fill me-1 text-danger"></i> <%= listing.location %>, <%= listing.country %>
        </p>

        <!-- Leaflet Map Box -->
        <div id="showMap" class="rounded-4 overflow-hidden border shadow-sm mb-3" style="height: 320px; width: 100%;"></div>

        <!-- Nearby Landmarks Interactive Pills -->
        <div class="d-flex flex-wrap gap-2 mt-2">
          <span class="badge bg-light text-dark border rounded-pill px-3 py-2 small"><i class="bi bi-compass text-primary me-1"></i> Scenic Viewpoint (450m)</span>
          <span class="badge bg-light text-dark border rounded-pill px-3 py-2 small"><i class="bi bi-cup-hot text-warning me-1"></i> Cafes & Dining (800m)</span>
          <span class="badge bg-light text-dark border rounded-pill px-3 py-2 small"><i class="bi bi-water text-info me-1"></i> Water & Beach Access (1.5 km)</span>
          <span class="badge bg-light text-dark border rounded-pill px-3 py-2 small"><i class="bi bi-taxi-front text-secondary me-1"></i> Transit Hub (15 min)</span>
        </div>
      </div>

      <!-- Meet your Host -->
      <div class="border-bottom pb-4 mb-4">
        <div class="card border rounded-4 p-4 bg-body shadow-xs">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold fs-4" style="width: 50px; height: 50px;">
                <%= listing.owner && listing.owner.username ? listing.owner.username.charAt(0).toUpperCase() : 'H' %>
              </div>
              <div>
                <h6 class="fw-bold text-dark mb-0">Hosted by <%= listing.owner ? listing.owner.username : 'Superhost' %></h6>
                <small class="text-muted">Response rate: 100% • Responds within an hour</small>
              </div>
            </div>
            <button class="btn btn-outline-dark rounded-pill px-3 py-2 fw-semibold btn-sm" data-bs-toggle="modal" data-bs-target="#contactHostModal">
              <i class="bi bi-chat-dots me-1"></i> Contact Host
            </button>
          </div>
          <p class="small text-muted mb-0">
            To protect your payment, never transfer money or communicate outside of the FairStay website or app.
          </p>
        </div>
      </div>

      <!-- Owner Actions (Edit / Delete) if Owner -->
      <% if (currUser && (listing.owner && listing.owner._id.equals(currUser._id) || currUser.isAdmin)) { %>
        <div class="d-flex align-items-center gap-3 border-bottom pb-4 mb-4">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-dark rounded-pill px-4 btn-sm">
            <i class="bi bi-pencil-square me-1"></i> Edit Stay
          </a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to remove this stay from FairStay?');">
            <button class="btn btn-outline-danger rounded-pill px-4 btn-sm" type="submit">
              <i class="bi bi-trash3 me-1"></i> Delete Stay
            </button>
          </form>
        </div>
      <% } %>

      <!-- Guest Reviews Section -->
      <div class="mb-4" id="reviewsSection">
        <div class="d-flex align-items-center justify-content-between mb-4">
          <h4 class="fw-bold text-dark mb-0">
            <i class="bi bi-star-fill text-warning me-1"></i>
            <%= avgRating > 0 ? avgRating : '5.0' %> • <%= listing.reviews.length %> <%= listing.reviews.length === 1 ? 'Review' : 'Reviews' %>
          </h4>
        </div>

        <!-- Rating Breakdown Metrics -->
        <div class="row g-3 mb-4 pb-3 border-bottom">
          <div class="col-sm-6">
            <div class="d-flex justify-content-between small text-dark mb-1">
              <span>Cleanliness</span>
              <span class="fw-bold">4.9</span>
            </div>
            <div class="rating-bar-container"><div class="rating-bar-fill" style="width: 98%;"></div></div>
          </div>
          <div class="col-sm-6">
            <div class="d-flex justify-content-between small text-dark mb-1">
              <span>Accuracy</span>
              <span class="fw-bold">4.9</span>
            </div>
            <div class="rating-bar-container"><div class="rating-bar-fill" style="width: 98%;"></div></div>
          </div>
          <div class="col-sm-6">
            <div class="d-flex justify-content-between small text-dark mb-1">
              <span>Communication</span>
              <span class="fw-bold">5.0</span>
            </div>
            <div class="rating-bar-container"><div class="rating-bar-fill" style="width: 100%;"></div></div>
          </div>
          <div class="col-sm-6">
            <div class="d-flex justify-content-between small text-dark mb-1">
              <span>Location</span>
              <span class="fw-bold">4.8</span>
            </div>
            <div class="rating-bar-container"><div class="rating-bar-fill" style="width: 96%;"></div></div>
          </div>
        </div>

        <!-- Add Review Form (for logged-in users) -->
        <% if (currUser) { %>
          <div class="card border rounded-4 p-4 bg-light mb-4 shadow-xs">
            <h6 class="fw-bold text-dark mb-2">Leave a Review</h6>
            <form action="/listings/<%= listing._id %>/reviews" method="POST">
              <!-- Interactive Star Picker -->
              <div class="mb-3">
                <label class="form-label small text-muted mb-1 d-block">Overall Rating</label>
                <div class="star-rating-widget">
                  <input type="radio" name="review[rating]" id="star5" value="5" checked />
                  <label for="star5" title="5 stars">★</label>
                  <input type="radio" name="review[rating]" id="star4" value="4" />
                  <label for="star4" title="4 stars">★</label>
                  <input type="radio" name="review[rating]" id="star3" value="3" />
                  <label for="star3" title="3 stars">★</label>
                  <input type="radio" name="review[rating]" id="star2" value="2" />
                  <label for="star2" title="2 stars">★</label>
                  <input type="radio" name="review[rating]" id="star1" value="1" />
                  <label for="star1" title="1 star">★</label>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label small text-muted mb-1">Your Stay Experience</label>
                <textarea name="review[comment]" class="form-control rounded-3" rows="3" placeholder="Share your experience about the views, comfort, host communication, and amenities..." required></textarea>
              </div>

              <button class="btn btn-primary btn-sm rounded-pill px-4 py-2 fw-bold" type="submit">
                Submit Review
              </button>
            </form>
          </div>
        <% } %>

        <!-- Reviews Grid -->
        <div class="row g-3">
          <% if (listing.reviews && listing.reviews.length > 0) { %>
            <% for (let review of listing.reviews) { %>
              <div class="col-md-6">
                <div class="card border rounded-4 p-3 h-100 shadow-xs bg-body">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="d-flex align-items-center gap-2">
                      <div class="rounded-circle bg-secondary-subtle text-secondary d-flex align-items-center justify-content-center fw-bold small" style="width: 36px; height: 36px;">
                        <%= review.author ? review.author.username.charAt(0).toUpperCase() : 'T' %>
                      </div>
                      <div>
                        <div class="fw-bold text-dark small"><%= review.author ? review.author.username : 'Traveler' %></div>
                        <div class="text-muted" style="font-size: 0.75rem;"><%= new Date(review.createdAt).toLocaleDateString('en-IN', { month: 'short', year: 'numeric' }) %></div>
                      </div>
                    </div>
                    <div class="text-warning small">
                      <% for (let s = 1; s <= review.rating; s++) { %>★<% } %>
                    </div>
                  </div>
                  <p class="small text-muted mb-2 flex-grow-1"><%= review.comment %></p>
                  <% if (currUser && (review.author && review.author._id.equals(currUser._id) || currUser.isAdmin)) { %>
                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="text-end">
                      <button class="btn btn-sm btn-link text-danger text-decoration-none p-0" style="font-size: 0.75rem;">
                        Delete
                      </button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% } %>
          <% } else { %>
            <p class="text-muted small">No reviews yet. Be the first guest to leave feedback!</p>
          <% } %>
        </div>
      </div>

      <!-- Interactive AI Concierge Card (Clean & Non-Intrusive) -->
      <div class="card border-0 bg-primary-subtle text-primary-emphasis rounded-4 p-3 shadow-xs mt-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
          <div class="d-flex align-items-center gap-3">
            <span class="fs-3">✨</span>
            <div>
              <h6 class="fw-bold mb-0">Have questions about this stay or <%= listing.location %>?</h6>
              <small class="text-muted">Ask our AI Trip Concierge about local dining, weather & activities</small>
            </div>
          </div>
          <button class="btn btn-primary rounded-pill btn-sm px-3 fw-bold shadow-xs" id="askAiAboutStayBtn">
            Ask AI Concierge
          </button>
        </div>
      </div>

    </div>

    <!-- Right Column: Interactive Sticky Booking Card (Clean, Transparent, Easy to Understand) -->
    <div class="col-lg-5" id="bookingWidget">
      <div class="sticky-top" style="top: 90px; z-index: 10;">
        <div class="card border-0 rounded-4 shadow-md p-4 reservation-card-luxury">
          
          <!-- Pricing Header -->
          <div class="d-flex justify-content-between align-items-baseline mb-3 pb-3 border-bottom">
            <div>
              <span class="fs-3 fw-bold text-dark" id="displayNightlyPrice">₹<%= listing.price.toLocaleString('en-IN') %></span>
              <span class="text-muted small">/ night</span>
            </div>
            <div class="small fw-semibold text-dark d-flex align-items-center gap-1">
              <i class="bi bi-star-fill text-warning"></i>
              <span><%= avgRating > 0 ? avgRating : '5.0' %></span>
              <span class="text-muted">(<%= listing.reviews.length %>)</span>
            </div>
          </div>

          <!-- Booking Form -->
          <form action="/listings/<%= listing._id %>/bookings" method="POST" id="bookingForm">
            
            <!-- Dates Picker Box (Compact Airbnb 2-Field Segment) -->
            <div class="reservation-date-box p-2 mb-3">
              <div class="row g-2">
                <div class="col-6 border-end">
                  <label class="form-label text-uppercase fw-bold text-muted mb-0" style="font-size: 0.65rem; letter-spacing: 0.05em;">Check-in</label>
                  <input type="text" id="checkInDate" name="booking[checkIn]" class="form-control form-control-sm border-0 bg-transparent fw-semibold p-0 cursor-pointer" placeholder="Select date" />
                </div>
                <div class="col-6">
                  <label class="form-label text-uppercase fw-bold text-muted mb-0" style="font-size: 0.65rem; letter-spacing: 0.05em;">Checkout</label>
                  <input type="text" id="checkOutDate" name="booking[checkOut]" class="form-control form-control-sm border-0 bg-transparent fw-semibold p-0 cursor-pointer" placeholder="Select date" />
                </div>
              </div>
            </div>

            <!-- Interactive Guest Stepper Dropdown -->
            <div class="position-relative mb-3">
              <div class="reservation-date-box p-2 cursor-pointer" id="guestPickerToggle">
                <label class="form-label text-uppercase fw-bold text-muted mb-0" style="font-size: 0.65rem; letter-spacing: 0.05em;">Guests</label>
                <div class="d-flex justify-content-between align-items-center">
                  <span class="fw-semibold text-dark small" id="guestDisplayLabel">2 guests</span>
                  <i class="bi bi-chevron-down text-muted small"></i>
                </div>
              </div>

              <!-- Stepper Popup -->
              <div class="guest-picker-dropdown" id="guestPickerDropdown">
                <!-- Adults -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <div>
                    <div class="fw-bold small text-dark">Adults</div>
                    <div class="text-muted" style="font-size: 0.72rem;">Age 13+</div>
                  </div>
                  <div class="d-flex align-items-center gap-2">
                    <button type="button" class="stepper-btn" id="adultsMinusBtn">-</button>
                    <span class="fw-bold px-2 small" id="adultsCountSpan">2</span>
                    <button type="button" class="stepper-btn" id="adultsPlusBtn">+</button>
                  </div>
                </div>

                <!-- Children -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <div>
