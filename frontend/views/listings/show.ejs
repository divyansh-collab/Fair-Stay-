<!-- 4. AI Festival Price Predictor Modal -->
<div class="modal fade" id="festivalPredictorModal" tabindex="-1" aria-labelledby="festivalPredictorModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 rounded-4 shadow-xl">
      <div class="modal-header border-bottom px-4 py-3 bg-light">
        <div class="d-flex align-items-center gap-2">
          <span class="fs-4">⚡</span>
          <div>
            <h5 class="modal-title fw-bold text-dark mb-0" id="festivalPredictorModalLabel">Seasonal Pricing Insights</h5>
            <small class="text-muted">AI-powered seasonal demand and rate forecasts</small>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        
        <!-- Controls Row -->
        <div class="row g-3 mb-4 align-items-end">
          <div class="col-md-8">
            <label class="form-label small fw-bold text-dark mb-1">
              Select City Season or Local Event (<%= listing.location || 'Local Calendar' %>)
            </label>
            <select class="form-select rounded-3 py-2" id="predictFestivalSelect">
              <% if (typeof destinationEvents !== 'undefined' && destinationEvents && destinationEvents.length > 0) { %>
                <% destinationEvents.forEach((ev, idx) => { %>
                  <option value="<%= ev.id %>" <%= idx === 0 ? 'selected' : '' %>>
                    <%= ev.emoji %> <%= ev.name %> (<%= ev.defaultPercentage >= 0 ? '+' : '' %><%= ev.defaultPercentage %>%)
                  </option>
                <% }); %>
              <% } else { %>
                <option value="christmas" selected>🎄 Christmas & Year-End Holidays (+25%)</option>
                <option value="diwali">🪔 Diwali Festive Week (+30%)</option>
                <option value="holi">🎨 Holi Spring Break (+20%)</option>
                <option value="rakshabandhan">🧵 Raksha Bandhan Long Weekend (+18%)</option>
                <option value="new_year">🎆 New Year's Eve Grand Peak (+35%)</option>
                <option value="monsoon_discount">🌧️ Monsoon Off-Season Discount (-15%)</option>
              <% } %>
            </select>
          </div>
        </div>

        <!-- AI Live Prediction Card -->
        <div class="card border rounded-4 p-4 mb-3 bg-light shadow-xs" id="aiPredictionResultCard">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 pb-3 border-bottom">
            <div>
              <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 mb-2">
                <i class="bi bi-stars me-1"></i> Real-Time Demand Analysis
              </span>
              <h4 class="fw-bold text-dark mb-0" id="predFestivalHeading">
                <%= (typeof destinationEvents !== 'undefined' && destinationEvents && destinationEvents.length > 0) ? (destinationEvents[0].emoji + ' ' + destinationEvents[0].name) : '🎄 Christmas & Year-End Holidays' %>
              </h4>
            </div>
            <div class="text-md-end">
              <div class="display-6 fw-bold <%= (typeof destinationEvents !== 'undefined' && destinationEvents && destinationEvents.length > 0 && destinationEvents[0].defaultPercentage < 0) ? 'text-success' : 'text-danger' %>" id="predPercentageBadge">
                <%= (typeof destinationEvents !== 'undefined' && destinationEvents && destinationEvents.length > 0) ? ((destinationEvents[0].defaultPercentage >= 0 ? '+' : '') + destinationEvents[0].defaultPercentage + '%') : '+25%' %>
              </div>
              <small class="text-muted fw-semibold" id="predDemandLevel">
                <%= (typeof destinationEvents !== 'undefined' && destinationEvents && destinationEvents.length > 0 && destinationEvents[0].defaultPercentage < 0) ? 'Seasonal Off-Peak' : 'High Seasonal Demand' %>
              </small>
            </div>
          </div>

          <div class="row g-3 mb-3 text-center">
            <div class="col-4">
              <div class="p-3 rounded-3 bg-white border h-100">
                <small class="text-muted d-block mb-1">Base Rate</small>
                <span class="fs-5 fw-bold text-dark" id="predNormalPrice">₹<%= listing.price.toLocaleString('en-IN') %></span>
                <span class="small text-muted d-block">/ night</span>
              </div>
            </div>
            <div class="col-4">
              <div class="p-3 rounded-3 bg-white border h-100">
                <% 
                  const firstEvPct = (typeof destinationEvents !== 'undefined' && destinationEvents && destinationEvents.length > 0) ? destinationEvents[0].defaultPercentage : 25;
                  const firstDiff = Math.round(listing.price * (firstEvPct / 100));
                %>
                <small class="text-muted d-block mb-1">Seasonal Impact</small>
                <span class="fs-5 fw-bold <%= firstDiff >= 0 ? 'text-danger' : 'text-success' %>" id="predPriceDiff">
                  <%= firstDiff >= 0 ? '+' : '' %>₹<%= firstDiff.toLocaleString('en-IN') %>
                </span>
                <span class="small text-muted d-block" id="predDiffPercent">(<%= firstEvPct >= 0 ? '+' : '' %><%= firstEvPct %>%)</span>
              </div>
            </div>
            <div class="col-4">
              <div class="p-3 rounded-3 bg-primary text-white shadow-sm h-100">
                <% const firstEff = listing.price + firstDiff; %>
                <small class="text-white-50 d-block mb-1">Effective Rate</small>
                <span class="fs-5 fw-bold" id="predEffectivePrice">₹<%= firstEff.toLocaleString('en-IN') %></span>
                <span class="small text-white-50 d-block">/ night</span>
              </div>
            </div>
          </div>

          <!-- AI Contextual Explanation & Tip -->
          <div class="mb-3 p-3 rounded-3 bg-white border">
            <div class="d-flex align-items-start gap-2 mb-2">
              <span class="fs-5 text-primary">💡</span>
              <div>
                <strong class="d-block text-dark small">City Season & Event Dynamics:</strong>
                <p class="small text-muted mb-0" id="predExplanationText">
                  <%= (typeof destinationEvents !== 'undefined' && destinationEvents && destinationEvents.length > 0) ? destinationEvents[0].summary : 'AI analyzing seasonal travel demand and local event calendar...' %>
                </p>
              </div>
            </div>
            <div class="d-flex align-items-start gap-2 pt-2 border-top">
              <span class="fs-6 text-warning">📌</span>
              <div>
                <strong class="d-block text-dark small" style="font-size: 0.78rem;">Traveler Insight:</strong>
                <p class="small text-muted mb-0" id="predTravelerTip" style="font-size: 0.78rem;">
                  Lock in this <%= listing.location || 'vacation' %> stay early under FairSafe™ zero-surge protection.
                </p>
              </div>
            </div>
          </div>

          <!-- Real-World Hospitality Economics & Verification Box -->
          <div class="mb-3 p-3 rounded-3 bg-white border">
            <h6 class="fw-bold text-dark mb-2 small d-flex align-items-center gap-1">
              <i class="bi bi-graph-up-arrow text-primary"></i> Real-World Market Signals & Why Rates Change:
            </h6>
            <div class="row g-2 small text-muted">
              <div class="col-sm-6">
                <div class="p-2 rounded bg-light border-0">
                  <span class="d-block fw-semibold text-dark" style="font-size: 0.75rem;">🏨 City Occupancy Compression:</span>
                  <span id="predOccupancyRate" class="fw-bold text-primary">94%+ (Peak Compression)</span>
                </div>
              </div>
              <div class="col-sm-6">
                <div class="p-2 rounded bg-light border-0">
                  <span class="d-block fw-semibold text-dark" style="font-size: 0.75rem;">🌤️ Seasonal Climate Impact:</span>
                  <span id="predWeatherIndex">Pleasant holiday weather</span>
                </div>
              </div>
              <div class="col-12">
                <div class="p-2 rounded bg-light border-0">
                  <span class="d-block fw-semibold text-dark" style="font-size: 0.75rem;">👥 Primary Influx Driver:</span>
                  <span id="predPrimaryDriver">High localized event influx exceeding fixed hotel inventory</span>
                </div>
              </div>
              <div class="col-12">
                <div class="p-2 rounded bg-light border-0">
                  <span class="d-block fw-semibold text-dark" style="font-size: 0.75rem;">⚖️ Why Not Generic Holidays (e.g. Diwali)?</span>
                  <span id="predWhyNotDiwali" style="font-size: 0.75rem;">
                    Generic holidays see domestic travelers celebrating at home with family. In leisure hubs, rate changes are driven strictly by local event calendars, weather, and room supply compression.
                  </span>
                </div>
              </div>
            </div>
          </div>

          <div class="p-2 px-3 rounded-3 bg-success-subtle text-success-emphasis border border-success-subtle small">
            <i class="bi bi-shield-check me-1"></i> <strong>FairSafe™ Price Lock:</strong> Once reserved, your rate is 100% locked with zero hidden fees.
          </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
          <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" id="applyFestivalToStayBtn">
            Apply Rate & Dates
          </button>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- Mobile Sticky Bottom Reservation Bar (Screens < 992px) -->
<div class="mobile-sticky-reservation-bar d-flex d-lg-none justify-content-between align-items-center">
  <div>
    <div class="d-flex align-items-baseline gap-1">
      <span class="fw-bold fs-5 text-dark">₹<%= listing.price.toLocaleString('en-IN') %></span>
      <span class="text-muted small">/ night</span>
    </div>
    <div class="text-muted small" style="font-size: 0.75rem;">
      <i class="bi bi-star-fill text-warning"></i>
      <span class="text-dark fw-bold"><%= avgRating > 0 ? avgRating : '5.0' %></span>
      <span>• <%= listing.reviews.length %> <%= listing.reviews.length === 1 ? 'review' : 'reviews' %></span>
    </div>
  </div>
  <div>
    <a href="#bookingForm" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm" onclick="document.getElementById('bookingForm').scrollIntoView({behavior: 'smooth'}); return false;">
      Reserve Stay
    </a>
  </div>
</div>

<!-- Data for Leaflet Show Map & Show Page Scripts -->
<script>
  window.listingId = "<%= listing._id %>";
  window.listingCoords = <%- JSON.stringify(listing.geometry ? listing.geometry.coordinates : [83.0064, 25.3109]) %>;
  window.listingTitle = <%- JSON.stringify(listing.title) %>;
  window.listingLocation = <%- JSON.stringify(listing.location) %>;
  window.listingPrice = <%= listing.price %>;
  window.activeFestival = <%- JSON.stringify(festivalData) %>;
  window.destinationEvents = <%- JSON.stringify(typeof destinationEvents !== 'undefined' ? destinationEvents : []) %>;
  window.festivalMultiplier = 1.0;
  window.organicPhoto = <%- JSON.stringify(organicPhoto) %>;
  window.bookedDateRanges = <%- JSON.stringify(typeof bookedRanges !== 'undefined' ? bookedRanges : []) %>;

  const GALLERY_PHOTOS = [
    { url: "<%- organicPhoto %>", title: "Main Verified Stay & Space" },
    { url: "<%- photo2 %>", title: "Architecture & Grounds" },
    { url: "<%- photo3 %>", title: "Master Suite & Bedroom" },
    { url: "<%- photo4 %>", title: "Living Lounge & Comfort" },
    { url: "<%- photo5 %>", title: "Scenic Patio & Views" }
  ];

  let currentGalleryIndex = 0;

  // Hoist modals immediately to document.body so they never collide with container stacking contexts
  function hoistPageModals() {
    ['galleryModal', 'allAmenitiesModal', 'contactHostModal', 'festivalPredictorModal'].forEach(function (id) {
      const el = document.getElementById(id);
      if (el && el.parentElement && el.parentElement !== document.body) {
        document.body.appendChild(el);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', hoistPageModals);
  } else {
    hoistPageModals();
  }

  function openGalleryModal(index) {
    hoistPageModals();
    const idx = (index !== undefined && !isNaN(index)) ? Number(index) : 0;
    setLightboxPhotoByIndex(idx);
    const modalEl = document.getElementById('galleryModal');
    if (!modalEl) return;

    if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
      const modal = bootstrap.Modal.getOrCreateInstance(modalEl, {
        backdrop: true,
        keyboard: true
      });
      modal.show();
    } else {
      modalEl.classList.add('show');
      modalEl.style.display = 'block';
      modalEl.setAttribute('aria-modal', 'true');
      modalEl.removeAttribute('aria-hidden');
      document.body.classList.add('modal-open');
    }
  }

  function closeGalleryModal() {
    const modalEl = document.getElementById('galleryModal');
    if (modalEl) {
      if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
        try {
          const inst = bootstrap.Modal.getInstance(modalEl) || bootstrap.Modal.getOrCreateInstance(modalEl);
          if (inst) inst.hide();
        } catch (e) {}
      }
      modalEl.classList.remove('show');
      modalEl.style.display = 'none';
      modalEl.setAttribute('aria-hidden', 'true');
      modalEl.removeAttribute('aria-modal');
    }
    // Instant DOM cleanup: remove backdrops, unlock body scroll
    document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
    document.body.classList.remove('modal-open');
    document.body.style.overflow = '';
    document.body.style.paddingRight = '';
  }

  // Ensure full backdrop cleanup on modal hide
  document.addEventListener('DOMContentLoaded', function () {
    const modalEl = document.getElementById('galleryModal');
    if (modalEl) {
      modalEl.addEventListener('hidden.bs.modal', function () {
        document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
        document.body.classList.remove('modal-open');
        document.body.style.overflow = '';
        document.body.style.paddingRight = '';
      });
    }

    // Touch Swipe & Drag Physics for Gallery Stage
    const stage = document.getElementById('galleryStage');
    if (stage) {
      let touchStartX = 0;
      let touchStartY = 0;
      let mouseStartX = 0;
      let mouseStartY = 0;
      let isMouseDown = false;

      // Touch events (Mobile / Tablet)
      stage.addEventListener('touchstart', function (e) {
        if (e.touches && e.touches.length === 1) {
          touchStartX = e.touches[0].clientX;
          touchStartY = e.touches[0].clientY;
        }
      }, { passive: true });

      stage.addEventListener('touchend', function (e) {
        if (e.changedTouches && e.changedTouches.length === 1) {
          const deltaX = e.changedTouches[0].clientX - touchStartX;
          const deltaY = e.changedTouches[0].clientY - touchStartY;
          handleSwipeGesture(deltaX, deltaY);
        }
      }, { passive: true });

      // Mouse drag events (Desktop)
      stage.addEventListener('mousedown', function (e) {
        if (e.button !== 0) return;
        if (e.target.closest('.gallery-nav-btn, .gallery-close-btn, .lightbox-thumb')) return;
        mouseStartX = e.clientX;
        mouseStartY = e.clientY;
        isMouseDown = true;
      });

      window.addEventListener('mouseup', function (e) {
        if (!isMouseDown) return;
        isMouseDown = false;
        const deltaX = e.clientX - mouseStartX;
        const deltaY = e.clientY - mouseStartY;
        handleSwipeGesture(deltaX, deltaY);
      });

      function handleSwipeGesture(deltaX, deltaY) {
        const absX = Math.abs(deltaX);
        const absY = Math.abs(deltaY);
        // Horizontal swipe threshold: 40px
        if (absX > 40 && absX > absY) {
          if (deltaX < 0) {
            navigateGallery(1); // Swipe left -> next image
          } else {
            navigateGallery(-1); // Swipe right -> prev image
          }
        } else if (deltaY > 80 && absY > absX) {
          // Swipe down -> close lightbox
          closeGalleryModal();
        }
      }

      // Backdrop click to close (clicking empty stage outside the photo or buttons)
      stage.addEventListener('click', function (e) {
        if (e.target === stage || e.target.id === 'galleryImgWrapper') {
          closeGalleryModal();
        }
      });
    }
  });

  function navigateGallery(direction) {
    let nextIndex = currentGalleryIndex + direction;
    if (nextIndex < 0) nextIndex = GALLERY_PHOTOS.length - 1;
    if (nextIndex >= GALLERY_PHOTOS.length) nextIndex = 0;
    setLightboxPhotoByIndex(nextIndex);
  }

  function setLightboxPhotoByIndex(index) {
    if (index < 0 || index >= GALLERY_PHOTOS.length) index = 0;
    currentGalleryIndex = index;
    const photo = GALLERY_PHOTOS[index];

    const img = document.getElementById('galleryModalImg');
    const counter = document.getElementById('galleryPhotoCounter');
    const caption = document.getElementById('galleryPhotoCaption');

    if (img && photo) {
      img.style.opacity = '0.35';
      img.style.transform = 'scale(0.98)';
      img.src = photo.url;
      img.onload = () => {
        img.style.opacity = '1';
        img.style.transform = 'scale(1)';
      };
      setTimeout(() => {
        img.style.opacity = '1';
        img.style.transform = 'scale(1)';
      }, 150);
    }
    if (counter) counter.textContent = `${index + 1} / ${GALLERY_PHOTOS.length}`;
    if (caption && photo) caption.textContent = photo.title;

    const thumbs = document.querySelectorAll('.lightbox-thumb');
    thumbs.forEach((thumb, i) => {
      if (i === index) {
        thumb.classList.add('active', 'border-primary', 'border-3');
        thumb.classList.remove('opacity-60');
        thumb.style.transform = 'scale(1.1)';
      } else {
        thumb.classList.remove('active', 'border-primary', 'border-3');
        thumb.classList.add('opacity-60');
        thumb.style.transform = 'scale(1)';
      }
    });
  }

  // Keyboard navigation
  window.addEventListener('keydown', function (e) {
    const modalEl = document.getElementById('galleryModal');
    if (modalEl && (modalEl.classList.contains('show') || modalEl.style.display === 'block')) {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        navigateGallery(-1);
      }
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        navigateGallery(1);
      }
      if (e.key === 'Escape') {
        e.preventDefault();
        closeGalleryModal();
      }
    }
  });

  window.openGalleryModal = openGalleryModal;
  window.closeGalleryModal = closeGalleryModal;
  window.navigateGallery = navigateGallery;
  window.setLightboxPhotoByIndex = setLightboxPhotoByIndex;
</script>
<script src="/js/show-page.js"></script>
