              <div class="portal-weather-fx portal-sun-fx"></div>
              <div class="card-glare-overlay"></div>

              <!-- Portal Photo Media -->
              <div class="portal-img-wrapper">
                <img
                  src="https://maps.googleapis.com/maps/api/place/photo?maxwidth=1200&photoreference=AVoNoXRLr_02wRbNhRu1XTaeSzZu8_3b6k5CjSRCB0KYqm8-qmOqDYtzGPw6Y6ygYrnoi-C6LIwN2ivysYRvtCelCam76TK2GRF19lxs16D-_UELXSqRuTSgzJXNUd0qci16vexKvzs199hDJ2TcCTxGSuxCMthOZ7qiw_swbfgojZZFXAP4b_zR9EJY5LpnFdnRwJnNoG6vwICd1rfM-QY-Xkq4FfGKAVH0nGlX_4wRn78AIWLn8KdrDsiHT5z30evVY9Ri_iqIkneD6UkGrXFjRM8xIs6NV3Ya9vxC97KFfzUKjstaY0cFukNULy5ygEIdtsMo25QBss_KzujIA2Pu7kO1oNSDkTxpDZcectAeMWU_hyMB1m6Rblbvl9aDkZSI4QSVbA06_cP2khGBrqy27peJLS3khZEkOr2doqI4lW3Pkw&key=AIzaSyCKw83mRoiJbI264dwnAQcJ9T_dczPHIug"
                  alt="Goa Sunset Bliss"
                  class="portal-img"
                  loading="lazy"
                />
              </div>

              <!-- Top Weather Pill (Floating translateZ) -->
              <div class="portal-weather-badge position-absolute top-0 end-0 m-3 rounded-pill px-3 py-1 d-flex align-items-center gap-1">
                <span>🌤️</span>
                <span class="small fw-bold">28°C</span>
              </div>

              <!-- Bottom Glass Details Bar (Floating translateZ) -->
              <div class="portal-footer-glass position-absolute bottom-0 start-0 end-0 p-3">
                <div class="d-flex align-items-baseline justify-content-between mb-1">
                  <h4 class="fw-extrabold text-white mb-0">Goa</h4>
                  <span class="badge bg-warning text-dark small fw-bold">4.9 ★</span>
