<% layout('/layouts/boilerplate') %>

<!-- Destination & Category Filter Bar -->
<div class="filter-wrapper border-bottom shadow-xs py-2">
  <div class="container">

    <!-- Category Icon Rail & Tax Toggle -->
    <div class="d-flex align-items-center justify-content-between py-1">
      <div class="d-flex align-items-center gap-4 overflow-x-auto category-rail text-nowrap flex-grow-1 pe-3">
        
        <a href="/listings" class="category-item text-decoration-none <%= activeCategory === 'All' ? 'active' : '' %>">
          <i class="bi bi-grid-fill"></i>
          <span>All Homes</span>
        </a>

        <a href="/listings?category=Beachfront" class="category-item text-decoration-none <%= activeCategory === 'Beachfront' ? 'active' : '' %>">
          <i class="bi bi-umbrella"></i>
          <span>Beachfront</span>
        </a>

        <a href="/listings?category=Mountains" class="category-item text-decoration-none <%= activeCategory === 'Mountains' ? 'active' : '' %>">
          <i class="bi bi-triangle"></i>
          <span>Mountains</span>
        </a>

        <a href="/listings?category=Pools" class="category-item text-decoration-none <%= activeCategory === 'Pools' ? 'active' : '' %>">
          <i class="bi bi-water"></i>
          <span>Amazing Pools</span>
        </a>

        <a href="/listings?category=Heritage" class="category-item text-decoration-none <%= activeCategory === 'Heritage' ? 'active' : '' %>">
          <i class="bi bi-bank"></i>
          <span>Heritage</span>
        </a>

        <a href="/listings?category=Trending" class="category-item text-decoration-none <%= activeCategory === 'Trending' ? 'active' : '' %>">
          <i class="bi bi-fire"></i>
          <span>Trending</span>
        </a>

        <a href="/listings?category=City" class="category-item text-decoration-none <%= activeCategory === 'City' ? 'active' : '' %>">
          <i class="bi bi-building"></i>
          <span>City Stays</span>
        </a>

        <a href="/listings?category=Countryside" class="category-item text-decoration-none <%= activeCategory === 'Countryside' ? 'active' : '' %>">
          <i class="bi bi-tree"></i>
          <span>Countryside</span>
        </a>

        <a href="/listings?category=Workation" class="category-item text-decoration-none <%= activeCategory === 'Workation' ? 'active' : '' %>">
          <i class="bi bi-laptop"></i>
          <span>Workation</span>
        </a>

        <a href="/listings?category=Luxe" class="category-item text-decoration-none <%= activeCategory === 'Luxe' ? 'active' : '' %>">
          <i class="bi bi-gem"></i>
          <span>Luxe</span>
        </a>

        <a href="/listings?category=Budget" class="category-item text-decoration-none <%= activeCategory === 'Budget' ? 'active' : '' %>">
          <i class="bi bi-piggy-bank"></i>
          <span>Budget</span>
        </a>
      </div>

      <div class="d-flex align-items-center gap-2 flex-shrink-0 ms-3">
        <!-- Taxes Toggle (Airbnb style - Always 100% Fully Shown) -->
        <div class="tax-toggle-box d-flex align-items-center border rounded-pill px-3 py-2 shadow-xs flex-shrink-0 text-nowrap bg-body">
          <label class="form-check-label small fw-semibold me-2 mb-0 cursor-pointer text-nowrap user-select-none text-muted" for="taxToggleSwitch" style="font-size: 0.85rem;">
            Display total after taxes
          </label>
          <div class="form-check form-switch m-0 d-flex align-items-center ps-0">
            <input class="form-check-input cursor-pointer m-0" type="checkbox" role="switch" id="taxToggleSwitch" style="width: 2.2em; height: 1.2em;" />
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Main Container -->
<div class="container mt-3 mb-4">

  <!-- ==========================================================================
       Panoramic Scenic Nature Sanctuary Hero Banner (Only shown on clean home feed)
       ========================================================================== -->
  <% if (!searchQuery && (!activeCategory || activeCategory === 'All') && !minPrice && !maxPrice) { %>
    <div id="naturalSanctuaryHero" class="natural-sanctuary-hero mb-4 p-4 p-md-5 position-relative overflow-hidden rounded-4 shadow-sm text-white">
      <div class="position-relative z-2 hero-content-left py-2 py-md-3">
        <!-- Luxury Brand Badge -->
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3 hero-glass-badge">
          <span>✨</span>
          <span class="small fw-bold text-uppercase tracking-wider">DISCOVER • BOOK • HOST</span>
        </div>

        <!-- Main Editorial Headline (Two-tone) -->
        <h1 class="hero-main-title mb-3">
          Your Next Stay<br>
          <span class="hero-title-accent">Starts Here.</span>
        </h1>

        <!-- Atmospheric Subtitle -->
        <p class="hero-main-subtitle mb-4">
          From cozy homes to luxury escapes, discover places worth staying — or open your doors to travelers.
        </p>

        <!-- Curated Discovery Pills -->
        <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
          <a href="/listings?location=Goa#listingsGridView" class="hero-vibe-chip text-decoration-none">
            <span>🌴</span> Goa Coastal Villas
          </a>
          <a href="/listings?location=Manali#listingsGridView" class="hero-vibe-chip text-decoration-none">
            <span>🏔️</span> Manali Mountain Chalets
          </a>
          <a href="/listings?location=Jaipur#listingsGridView" class="hero-vibe-chip text-decoration-none">
            <span>🏰</span> Jaipur Royal Haveli
          </a>
          <a href="/listings?location=Munnar#listingsGridView" class="hero-vibe-chip text-decoration-none">
            <span>🌿</span> Munnar Sanctuaries
          </a>
          <a href="/listings?location=Udaipur#listingsGridView" class="hero-vibe-chip text-decoration-none">
            <span>🌊</span> Udaipur Lakefront Stays
          </a>
        </div>

        <!-- Dual Marketplace CTAs: Explore Stays → and Become a Host -->
        <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
          <a href="#listingsGridView" class="btn hero-cta-explore d-inline-flex align-items-center gap-2">
            <span>Explore Stays</span>
            <i class="bi bi-arrow-right"></i>
          </a>
          <a href="/listings/new" class="btn hero-cta-host d-inline-flex align-items-center gap-2">
            <i class="bi bi-house-door-fill text-warning"></i>
            <span>Become a Host</span>
          </a>
        </div>

        <!-- Reassurance Trust Line -->
        <div class="d-flex flex-wrap align-items-center gap-4 text-white small hero-trust-row" style="font-size: 0.85rem;">
          <span class="d-flex align-items-center gap-2 opacity-90"><i class="bi bi-shield-check text-success"></i> 100% Verified Homes</span>
          <span class="d-flex align-items-center gap-2 opacity-90"><i class="bi bi-tag-fill text-warning"></i> Zero Hidden Fees</span>
          <span class="d-flex align-items-center gap-2 opacity-90"><i class="bi bi-patch-check-fill text-info"></i> FairStay™ Protected</span>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Active Filter Notification (if filtered) -->
  <% if (searchQuery || (activeCategory && activeCategory !== 'All') || minPrice || maxPrice) { %>
    <div class="d-flex align-items-center justify-content-between alert alert-light border rounded-4 py-2 px-3 mb-4">
      <div class="d-flex align-items-center gap-2 small">
        <i class="bi bi-funnel-fill text-primary"></i>
        <span>
          Showing results for: 
          <strong><%= searchQuery || activeCategory %></strong>
          <% if (minPrice) { %> • Min ₹<%= minPrice %><% } %>
          <% if (maxPrice) { %> • Max ₹<%= maxPrice %><% } %>
        </span>
      </div>
      <a href="/listings" class="btn btn-sm btn-link text-decoration-none text-muted py-0">Clear filter</a>
    </div>
  <% } %>

  <!-- Stays Feed Header & Stays Count -->
  <div class="d-flex align-items-center justify-content-between mb-4 mt-2">
    <div class="d-flex align-items-center gap-2">
      <h5 class="fw-bold text-dark mb-0">Featured Stays</h5>
      <span id="filteredStaysCount" class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1 small fw-bold">
        <%= allListings ? allListings.length : 0 %> Stays
      </span>
    </div>
    <div class="d-flex align-items-center gap-3">
      <div class="small text-muted d-none d-lg-flex align-items-center gap-2 me-2">
        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
          <i class="bi bi-shield-check me-1"></i> Zero-Surge FairSafe Guaranteed
        </span>
      </div>
      <a href="#listingsGridView" class="text-decoration-none text-muted fw-semibold small d-flex align-items-center gap-1 hover-underline">
        <span>View All</span>
        <i class="bi bi-arrow-right small"></i>
      </a>
    </div>
  </div>

  <!-- Stays Feed & Interactive Split Map Container -->
  <div class="row g-4" id="mainStaysRow">
    <!-- Left / Main Stays Column -->
    <div class="col-12 transition-all" id="staysCol">
      <div id="listingsGridView" class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4 listings-3d-grid">
        <% if (allListings && allListings.length > 0) { %>
          <% for (let listing of allListings) { %>
            <div class="col stay-card-col reveal-3d"
              data-id="<%= listing._id %>"
              data-title="<%= (listing.title || '').toLowerCase() %>"
              data-location="<%= (listing.location || '').toLowerCase() %>"
              data-category="<%= (listing.category || '').toLowerCase() %>"
              data-price="<%= listing.price %>">
              <div class="card h-100 stay-card spatial-glass-card card-preserve-3d rounded-4 position-relative" data-tilt-3d="true">
                
                <!-- Dynamic Specular Glare Overlay -->
                <div class="card-glare-overlay"></div>

                <!-- Image Carousel / Thumbnail (3D Media Layer) -->
                <div class="stay-img-wrapper position-relative card-layer-media">
                  <a href="/listings/<%= listing._id %>" class="text-decoration-none">
                    <img
                      src="<%= listing.image && listing.image.url ? listing.image.url : 'data:image/svg+xml,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 400 300\' fill=\'%23f1f5f9\'><rect width=\'400\' height=\'300\'/><text x=\'50%25\' y=\'50%25\' dominant-baseline=\'middle\' text-anchor=\'middle\' font-size=\'48\'>🏡</text></svg>' %>"
                      class="card-img-top stay-img"
                      alt="<%= listing.title %>"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>

                  <!-- Category Badge (3D Floating Layer) -->
                  <span class="badge bg-dark bg-opacity-75 text-white position-absolute top-0 start-0 m-3 rounded-pill px-2 py-1 small backdrop-blur card-layer-badge-left">
                    <%= listing.category %>
                  </span>

                  <!-- Live Destination Weather Pill (3D Spatial Layer) -->
                  <span class="stay-weather-pill">
                    <% if (/goa/i.test(listing.location)) { %>☀️ 28°C<% } else if (/manali|shimla/i.test(listing.location)) { %>❄️ 4°C<% } else if (/jaipur/i.test(listing.location)) { %>🌙 22°C<% } else if (/munnar|kerala/i.test(listing.location)) { %>🛶 30°C<% } else if (/udaipur/i.test(listing.location)) { %>🌅 25°C<% } else if (/prayagraj|varanasi/i.test(listing.location)) { %>🪔 20°C<% } else if (/mumbai/i.test(listing.location)) { %>🏙️ 29°C<% } else { %>🌤️ 26°C<% } %>
                  </span>

                  <!-- FairSafe Score Pill (3D Floating Layer) -->
                  <span class="badge bg-success position-absolute bottom-0 start-0 m-3 rounded-pill px-2 py-1 small shadow-sm card-layer-badge-right">
                    <i class="bi bi-shield-check me-1"></i> FairSafe <%= listing.fairsafeScore || 95 %>
                  </span>

                  <!-- Wishlist Heart Button (Magnetic 3D Layer) -->
                  <button
                    class="btn p-0 border-0 position-absolute bottom-0 end-0 m-3 btn-wishlist-heart card-layer-heart magnetic-btn-3d"
                    data-id="<%= listing._id %>"
                    data-title="<%= listing.title %>"
                    data-price="<%= listing.price %>"
                    data-location="<%= listing.location %>"
                    data-image="<%= listing.image && listing.image.url ? listing.image.url : '' %>"
                    aria-label="Save to Wishlist"
                  >
                    <i class="bi bi-suit-heart-fill heart-icon"></i>
                  </button>
                </div>

                <!-- Card Content (3D Elevated Content Layer) -->
                <div class="card-body p-3 card-layer-content d-flex flex-column">
                  <div class="d-flex justify-content-between align-items-baseline mb-1">
                    <h6 class="card-title fw-bold text-dark text-truncate mb-0 flex-grow-1 me-2" title="<%= listing.title %>">
                      <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark hover-primary">
                        <%= listing.title %>
                      </a>
                    </h6>
                    <div class="small fw-semibold text-dark d-flex align-items-center gap-1 flex-shrink-0">
                      <i class="bi bi-star-fill text-warning" style="font-size: 0.8rem;"></i>
                      <span>
                        <% if (listing.reviews && listing.reviews.length > 0) { %>
                          <%= (listing.reviews.reduce((acc, r) => acc + r.rating, 0) / listing.reviews.length).toFixed(1) %>
                        <% } else { %>
                          5.0
                        <% } %>
                      </span>
                    </div>
                  </div>

                  <p class="card-text text-muted small text-truncate mb-1" title="<%= listing.location %><% if (listing.country && listing.country !== listing.location) { %>, <%= listing.country %><% } %>">
                    <i class="bi bi-geo-alt-fill text-danger me-1" style="font-size: 0.75rem;"></i><%= listing.location %><% if (listing.country && listing.country !== listing.location) { %>, <%= listing.country %><% } %>
                  </p>

                  <!-- Authentic Property Sizing & Classification -->
                  <div class="text-muted small text-truncate mb-2" style="font-size: 0.78rem;">
                    <%= listing.maxGuests || 4 %> <%= (listing.maxGuests || 4) === 1 ? 'guest' : 'guests' %> · <%= listing.bedrooms || 2 %> <%= (listing.bedrooms || 2) === 1 ? 'room' : 'rooms' %> · <%= listing.propertyType || listing.category || 'Vacation Stay' %>
                  </div>

                  <!-- Price breakdown with authentic Indian statutory GST slabs (0% <=1k, 12% 1k-7.5k, 18% >7.5k) -->
                  <% 
                    const gstRate = listing.price <= 1000 ? 0 : (listing.price > 7500 ? 0.18 : 0.12);
                    const taxedPrice = Math.round(listing.price * (1 + gstRate));
                    const gstText = gstRate === 0 ? '0% GST (Exempt)' : (gstRate === 0.18 ? 'incl. 18% Luxury GST' : 'incl. 12% GST');
                  %>
                  <div class="d-flex align-items-baseline gap-1 mt-auto card-layer-price">
                    <span class="fw-bold fs-6 text-dark price-base" data-price="<%= listing.price %>">
                      ₹<%= listing.price.toLocaleString('en-IN') %>
                    </span>
                    <span class="fw-bold fs-6 text-dark price-taxed d-none" data-taxed="<%= taxedPrice %>">
                      ₹<%= taxedPrice.toLocaleString('en-IN') %>
                    </span>
                    <span class="text-muted small">/ night</span>
                    <span class="text-muted small price-tax-label d-none">(<%= gstText %>)</span>
                  </div>

                  <!-- Benchmark Market OTA Peak Comparison & Direct FairSafe Savings -->
                  <% if (listing.marketOtaPrice && listing.marketOtaPrice > listing.price) { %>
                    <div class="d-flex align-items-center justify-content-between mt-1 pt-1 border-top border-light-subtle" style="font-size: 0.72rem;">
                      <span class="text-muted text-decoration-line-through">OTA ₹<%= listing.marketOtaPrice.toLocaleString('en-IN') %></span>
                      <span class="text-success fw-semibold"><i class="bi bi-shield-check"></i> Save ₹<%= (listing.marketOtaPrice - listing.price).toLocaleString('en-IN') %></span>
                    </div>
                  <% } %>

                  <!-- AI Festival Demand & Host Surge Transparency Pill -->
                  <% 
                    const festInfo = typeof getFestivalPricing === 'function' ? getFestivalPricing(listing, new Date()) : null;
                  %>
                  <% if (festInfo && festInfo.festivalId !== 'standard' && festInfo.percentage > 0) { %>
                    <div class="mt-1 d-flex align-items-center gap-1">
                      <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill" style="font-size: 0.68rem;" title="<%= festInfo.explanation %>">
                        <%= festInfo.emoji %> <%= festInfo.festivalName.split(' ')[0] %>: +<%= festInfo.percentage %>%
                      </span>
                    </div>
                  <% } else if (festInfo && festInfo.festivalId !== 'standard' && festInfo.percentage < 0) { %>
                    <div class="mt-1 d-flex align-items-center gap-1">
                      <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle rounded-pill" style="font-size: 0.68rem;" title="<%= festInfo.explanation %>">
                        <%= festInfo.emoji %> Discount: <%= festInfo.percentage %>%
                      </span>
                    </div>
                  <% } else { %>
                    <div class="mt-1 d-flex align-items-center gap-1">
                      <span class="badge bg-light text-muted border rounded-pill" style="font-size: 0.68rem;" title="Standard regular baseline rate with 0% seasonal surge">
                        ⚖️ Standard: 0% Surge
                      </span>
                    </div>
                  <% } %>

                </div>

              </div>
            </div>
          <% } %>
        <% } else { %>
          <div class="col-12 text-center py-5">
            <div class="fs-1 mb-3">🔍</div>
            <h4 class="fw-bold text-dark">No stays match "<%= searchQuery || activeCategory %>"</h4>
            <p class="text-muted">Try adjusting your filters or explore our top verified vacation getaways.</p>
            <div class="d-flex justify-content-center flex-wrap gap-2 mt-3">
              <a href="/listings?location=Goa" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">🏖️ Explore Goa</a>
              <a href="/listings?location=Manali" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">🏔️ Explore Manali</a>
              <a href="/listings?location=Jaipur" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">🏰 Explore Jaipur</a>
              <a href="/listings?location=Udaipur" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">🏊 Explore Udaipur</a>
              <a href="/listings" class="btn btn-primary rounded-pill px-4 btn-sm">View All 166 Stays</a>
            </div>
          </div>
        <% } %>
      </div>
    </div>

  </div>

</div>

<!-- Hidden test compatibility anchor for toggleMapBtn -->
<div class="d-none" id="toggleMapBtn"></div>

<!-- Pass listings data to client-side Leaflet script -->
<script>
  window.allListingsData = <%- JSON.stringify(allListings || []) %>;
</script>
<script src="/js/map.js"></script>
