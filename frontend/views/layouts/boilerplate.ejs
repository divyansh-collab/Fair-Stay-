<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script>
    (function () {
      const savedTheme = localStorage.getItem('fairstay_theme') || 'light';
      document.documentElement.setAttribute('data-bs-theme', savedTheme);
    })();
  </script>
  <title>FairStay — Vacation Rentals, Homes, Villas & Stays</title>
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏡</text></svg>" />

  <!-- Google Fonts: Inter (Body & Micro-UI) & Plus Jakarta Sans (Luxury Headings) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

  <!-- Leaflet CSS & JS (Loaded in <head> so L is immediately defined globally) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>

  <!-- Flatpickr CSS (Base layout) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />

  <!-- Toastify CSS -->
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css" />

  <!-- Custom FairStay CSS & 3D Spatial Motion Engine -->
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/motion-3d.css" />

  <!-- Pre-load Dark / Light Theme to prevent flash -->
  <script>
    (function () {
      const savedTheme = localStorage.getItem('fairstay_theme');
      const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = savedTheme ? savedTheme : (prefersDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-bs-theme', theme);
    })();
  </script>
</head>
<body class="d-flex flex-column min-vh-100">

  <!-- 3D Scroll Progress Glow Bar -->
  <div class="scroll-progress-3d" id="scrollProgress3d" style="width: 0%;"></div>

  <!-- Floating Capsule Navbar -->
  <%- include('../includes/navbar.ejs', { currUser: (typeof currUser !== 'undefined' ? currUser : (typeof locals !== 'undefined' && locals.currUser ? locals.currUser : null)) }) %>

  <!-- Flash Alerts -->
  <div class="container mt-3">
    <%- include('../includes/flash.ejs', { success: (typeof success !== 'undefined' ? success : (typeof locals !== 'undefined' ? locals.success : null)), error: (typeof error !== 'undefined' ? error : (typeof locals !== 'undefined' ? locals.error : null)) }) %>
  </div>

  <!-- Main Body Content -->
  <main class="flex-grow-1">
    <%- body %>
  </main>

  <!-- Offcanvas Wishlist Drawer -->
  <%- include('../includes/wishlist-drawer.ejs') %>

  <!-- Offcanvas Quick Reserve Drawer -->
  <%- include('../includes/quick-reserve-drawer.ejs') %>

  <!-- Modals (Notifications, Curated Experiences, Help Center, Smart Search) -->
  <%- include('../includes/modals.ejs') %>

  <!-- Floating ✨ FairStay AI Concierge Widget -->
  <%- include('../includes/ai-chat-widget.ejs') %>

  <!-- Footer -->
  <%- include('../includes/footer.ejs') %>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
  <!-- Three.js for 3D Destination Sphere & Particle World -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

  <!-- Custom Client Scripts & 3D Engine -->
  <script src="/js/script.js"></script>
  <script src="/js/ai-concierge.js"></script>
  <script src="/js/motion-3d.js"></script>
</body>
</html>
